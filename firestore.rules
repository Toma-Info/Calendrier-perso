rules_version = '2';

// Règles minimales pour un usage personnel : seul un utilisateur authentifié
// (y compris de façon anonyme, ce que fait automatiquement l'application)
// peut lire et écrire la collection "items".
//
// Limite à connaître : l'authentification anonyme s'active toute seule dès
// qu'on ouvre le site. Ces règles empêchent donc un robot ou un visiteur
// totalement extérieur au web de lire tes données au hasard, mais pas
// quelqu'un qui aurait le lien de ton site et l'ouvrirait volontairement.
// Ne partage pas publiquement l'URL de ton agenda si tu actives Firebase.
// Pour une isolation stricte par personne, remplace l'authentification
// anonyme par une connexion par e-mail/mot de passe et filtre par
// request.auth.uid == "TON_UID" — voir la documentation Firebase Auth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
